enum ProjectDatabaseActorType {
  USER
  GUEST
  SYSTEM
}

enum ProjectDatabaseChangeAction {
  RECORD_CREATED
  RECORD_UPDATED
  RECORD_DELETED
  FIELD_UPDATED
  COMMENT_ADDED
  FILE_UPLOADED
}

enum InvoiceStatus {
