  LIFETIME
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  LOST
  CONVERTED
  SPAM
  DUPLICATE
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

// ============================================================
// AUTH — Better Auth Compatible
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CUSTOMER)
  phone         String?
  bio           String?
  timezone      String   @default("Asia/Ho_Chi_Minh")
  locale        String   @default("vi")
  isActive      Boolean  @default(true)
  onboarded     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  organizationMembers OrganizationMember[]
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")

  // CRM
  assignedContacts Contact[] @relation("ContactAssignee")
  assignedDeals    Deal[]    @relation("DealAssignee")
  leadAssignments  Lead[]    @relation("LeadAssignee")
  resolvedLeadDupes LeadDuplicateLog[] @relation("LeadDuplicateResolver")

  // Projects
  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  taskComments   TaskComment[]
  projectActivities ProjectActivity[]
  createdProjectDatabases ProjectDatabase[]
  createdProjectDatabaseRecords ProjectDatabaseRecord[] @relation("ProjectDatabaseRecordCreatedBy")
  updatedProjectDatabaseRecords ProjectDatabaseRecord[] @relation("ProjectDatabaseRecordUpdatedBy")
  createdProjectDatabaseShareLinks ProjectDatabaseShareLink[]
  projectDatabaseChangeLogs ProjectDatabaseChangeLog[]

  // Finance
  createdQuotations Quotation[] @relation("QuotationCreator")
  createdInvoices   Invoice[]   @relation("InvoiceCreator")
  createdContracts  Contract[]  @relation("ContractCreator")
  assignedQuotations Quotation[] @relation("QuotationAssignee")
  assignedInvoices   Invoice[]   @relation("InvoiceAssignee")
  assignedContracts  Contract[]  @relation("ContractAssignee")

  // Courses
  instructorCourses Course[]               @relation("CourseInstructor")
  enrollments       Enrollment[]
  gradedAssignments AssignmentSubmission[] @relation("AssignmentGrader")
  submissions       AssignmentSubmission[] @relation("AssignmentStudent")
  lessonSchedules   LessonSchedule[]       @relation("LessonScheduleInstructor")

  // Notifications
  notifications Notification[]
  activityLogs  ActivityLog[]

  // Files
  uploadedFiles File[]

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// ============================================================
// ORGANIZATION (Multi-tenant ready)
// ============================================================

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logo          String?
  website       String?
  email         String?
  phone         String?
  address       String?
  description   String?
  ownerId       String
  isActive      Boolean   @default(true)
  plan          String    @default("free")
  trialEndsAt   DateTime?
  activeModules String[]  @default(["CRM", "FINANCIAL", "EDUCATION"])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner   User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members OrganizationMember[]

  moduleLicenses OrganizationModuleLicense[]
  moduleUsage    OrganizationModuleUsage[]

  settings       Setting[]
  emailTemplates EmailTemplate[]
  emailLogs      EmailLog[]
  importRuns     LegacyImportRun[]

  // CRM
  leadSources LeadSource[]
  leads       Lead[]
  leadTags    LeadTag[]
  leadForms   LeadForm[]
  leadWebhooks LeadWebhook[]
  contacts   Contact[]
  companies  Company[]
  deals      Deal[]
  dealStages DealStage[]
  serviceCategories ServiceCategory[]
  services          Service[]
  serviceOptions    ServiceOption[]
  dealServiceOptions DealServiceOption[]

  // Projects
  projects Project[]
  projectActivities ProjectActivity[]
  projectDatabases ProjectDatabase[]

  // Finance
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  contracts  Contract[]
  signatures DocumentSignature[]

  // Courses
  courses Course[]
  potentialStudents PotentialStudent[]

  // Marketing
  campaigns            Campaign[]
  socialConnections    SocialProviderConnection[]
  socialAssets         SocialProviderAsset[]
  socialCampaigns      SocialCampaign[]
  socialAdSets         SocialAdSet[]
  socialAds            SocialAd[]
  socialPosts          SocialPost[]
  socialInsights       SocialInsight[]
  socialSyncLogs       SocialMarketingSyncLog[]
  socialReportSettings SocialMarketingReportSetting?

  // CMS
  pages      Page[]
  sites      Site[]
  posts      Post[]
  categories Category[]
  tags       Tag[]
  media      Media[]

  // Files
  folders Folder[]
  files   File[]

  // Notifications
  activityLogs ActivityLog[]
  profile      OrganizationProfile?
  brand        OrganizationBrand?
  locale       OrganizationLocale?
  modules      OrganizationModule[]
  workflows    OrganizationWorkflow[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(MEMBER)
  permissions    String[]   @default([])
  joinedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationProfile {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  logo                String?
  favicon             String?
  coverImage          String?
  slogan              String?
  address             String?
  ward                String?
  district            String?
  province            String?
  country             String?
  postalCode          String?
  latitude            Decimal?
  longitude           Decimal?
  googleMapUrl        String?
  businessLicense     String?
  representativeName  String?
  representativeTitle String?
  representativePhone String?
  representativeEmail String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
}

model OrganizationBrand {
  id             String   @id @default(cuid())
  organizationId String   @unique
  primaryColor   String   @default("#F59E0B")
  secondaryColor String   @default("#3B82F6")
  accentColor    String   @default("#10B981")
  fontFamily     String   @default("var(--font-sans)")
  borderRadius   String   @default("0.5rem")
  buttonStyle    String   @default("solid")
  iconStyle      String   @default("solid")
  themeMode      String   @default("light")
  customCss      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_brands")
}

model OrganizationLocale {
  id             String   @id @default(cuid())
  organizationId String   @unique
  timezone       String   @default("Asia/Ho_Chi_Minh")
  language       String   @default("vi")
  currency       String   @default("VND")
  currencySymbol String   @default("₫")
  dateFormat     String   @default("DD/MM/YYYY")
  timeFormat     String   @default("HH:mm")
  firstDayOfWeek String   @default("1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_locales")
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleKey      String
  status         String   @default("ACTIVE")
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
  @@map("organization_modules")
}

model OrganizationWorkflow {
  id             String   @id @default(cuid())
  organizationId String
  moduleKey      String
  workflowKey    String
  settings       Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey, workflowKey])
  @@index([organizationId])
  @@map("organization_workflows")
}

model PlatformModule {
  id              String                 @id @default(cuid())
  code            String                 @unique
  name            String
  version         String                 @default("1.0.0")
  category        PlatformModuleCategory @default(WORKSPACE)
  description     String?
  icon            String?
  dependencies    String[]               @default([])
  defaultSettings Json?
  status          PlatformModuleStatus   @default(ACTIVE)
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  planModules PlanModule[]
  licenses    OrganizationModuleLicense[]

  @@map("platform_modules")
}

model PlatformPlan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  price       Decimal      @default(0) @db.Decimal(18, 2)
  currency    String       @default("VND")
  interval    PlanInterval @default(MONTHLY)
  limits      Json?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules  PlanModule[]
  licenses OrganizationModuleLicense[]

  @@map("platform_plans")
}

model PlanModule {
  id        String   @id @default(cuid())
  planId    String
  moduleId  String
  features  Json?
  limits    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan   PlatformPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([moduleId])
  @@map("plan_modules")
}

model OrganizationModuleLicense {
  id             String              @id @default(cuid())
  organizationId String
  moduleId       String
  planId         String?
  status         ModuleLicenseStatus @default(ACTIVE)
  enabled        Boolean             @default(true)
  startsAt       DateTime            @default(now())
  expiresAt      DateTime?
  features       Json?
  limits         Json?
  settings       Json?
  grantedById    String?
  grantedAt      DateTime            @default(now())
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plan         PlatformPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([organizationId, moduleId])
  @@index([organizationId])
  @@index([moduleId])
  @@index([planId])
  @@map("organization_module_licenses")
}

model OrganizationModuleUsage {
  id             String   @id @default(cuid())
  organizationId String
  moduleCode     String
  metric         String
  value          Decimal  @default(0) @db.Decimal(18, 2)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleCode, metric, periodStart, periodEnd])
  @@index([organizationId])
  @@index([moduleCode])
  @@map("organization_module_usage")
}

// ============================================================
// SOCIAL MARKETING MODULE
// ============================================================

model SocialProviderConnection {
  id              String                 @id @default(cuid())
  organizationId  String
  provider        SocialProvider
  externalUserId  String
  displayName     String?
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String
  tokenKeyVersion String                 @default("v1")
  tokenExpiresAt  DateTime?
  scopes          String[]               @default([])
  status          SocialConnectionStatus @default(PENDING)
  connectedAt     DateTime?
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?
  metadata        Json?
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       SocialProviderAsset[]
  campaigns    SocialCampaign[]
  adSets       SocialAdSet[]
  ads          SocialAd[]
  posts        SocialPost[]
  insights     SocialInsight[]
  syncLogs     SocialMarketingSyncLog[]

  @@unique([organizationId, provider, externalUserId])
  @@index([organizationId, provider, status])
  @@map("social_provider_connections")
}

model SocialProviderAsset {
  id               String          @id @default(cuid())
  organizationId   String
  connectionId     String
  provider         SocialProvider
  assetType        SocialAssetType
  externalId       String
  parentExternalId String?
  name             String
  avatarUrl        String?
  category         String?
  url              String?
  currency         String?
  timezone         String?
  followers        BigInt?
  likes            BigInt?
  selected         Boolean         @default(true)
  metadata         Json?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, assetType, externalId])
  @@index([organizationId, connectionId, assetType])
  @@map("social_provider_assets")
}

model SocialCampaign {
  id                  String             @id @default(cuid())
  organizationId      String
  connectionId        String
  provider            SocialProvider
  adAccountExternalId String
  externalId          String
  name                String
  objective           String?
  buyingType          String?
  status              SocialEntityStatus @default(UNKNOWN)
  rawStatus           String?
  dailyBudget         Decimal?           @db.Decimal(18, 4)
  lifetimeBudget      Decimal?           @db.Decimal(18, 4)
  currency            String?
  providerCreatedAt   DateTime?
  providerUpdatedAt   DateTime?
  metadata            Json?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, adAccountExternalId, status])
  @@map("social_campaigns")
}

model SocialAdSet {
  id                 String             @id @default(cuid())
  organizationId     String
  connectionId       String
  provider           SocialProvider
  campaignExternalId String
  externalId         String
  name               String
  status             SocialEntityStatus @default(UNKNOWN)
  rawStatus          String?
  dailyBudget        Decimal?           @db.Decimal(18, 4)
  lifetimeBudget     Decimal?           @db.Decimal(18, 4)
  optimizationGoal   String?
  billingEvent       String?
  metadata           Json?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, campaignExternalId, status])
  @@map("social_ad_sets")
}

model SocialAd {
  id                 String             @id @default(cuid())
  organizationId     String
  connectionId       String
  provider           SocialProvider
  campaignExternalId String
  adSetExternalId    String
  externalId         String
  name               String
  status             SocialEntityStatus @default(UNKNOWN)
  rawStatus          String?
  creative           Json?
  metadata           Json?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, adSetExternalId, status])
  @@map("social_ads")
}

model SocialPost {
  id             String         @id @default(cuid())
  organizationId String
  connectionId   String
  provider       SocialProvider
  pageExternalId String
  externalId     String
  caption        String?
  permalinkUrl   String?
  media          Json?
  publishedAt    DateTime?
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, pageExternalId, publishedAt])
  @@map("social_posts")
}

model SocialInsight {
  id                  String         @id @default(cuid())
  organizationId      String
  connectionId        String
  provider            SocialProvider
  entityType          String
  entityExternalId    String
  adAccountExternalId String?
  dateStart           DateTime
  dateStop            DateTime
  breakdownKey        String         @default("none")
  attributionWindow   String         @default("default")
  currency            String?
  spend               Decimal        @default(0) @db.Decimal(18, 4)
  reach               BigInt         @default(0)
  impressions         BigInt         @default(0)
  clicks              BigInt         @default(0)
  leads               Decimal        @default(0) @db.Decimal(18, 4)
  purchases           Decimal        @default(0) @db.Decimal(18, 4)
  purchaseValue       Decimal        @default(0) @db.Decimal(18, 4)
  actions             Json?
  rawPayload          Json?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, entityType, entityExternalId, dateStart, dateStop, breakdownKey, attributionWindow])
  @@index([organizationId, provider, dateStart, dateStop])
  @@index([organizationId, adAccountExternalId, dateStart])
  @@map("social_insights")
}

model SocialMarketingSyncLog {
  id             String           @id @default(cuid())
  organizationId String
  connectionId   String?
  provider       SocialProvider
  mode           SocialSyncMode
  scope          String
  status         SocialSyncStatus @default(QUEUED)
  idempotencyKey String
  cursor         String?
  dateFrom       DateTime?
  dateTo         DateTime?
  totalRecords   Int              @default(0)
  successRecords Int              @default(0)
  failedRecords  Int              @default(0)
  retryCount     Int              @default(0)
  errorCode      String?
  errorMessage   String?
  rateLimit      Json?
  initiatedById  String?
  correlationId  String
  startedAt      DateTime?
  completedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, provider, status, createdAt])
  @@map("social_marketing_sync_logs")
}

model SocialMarketingReportSetting {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  timezone          String    @default("Asia/Ho_Chi_Minh")
  currency          String    @default("VND")
  attributionWindow String    @default("default")
  scheduleEnabled   Boolean   @default(false)
  scheduleCron      String?
  historyMonths     Int       @default(25)
  selectedAssets    Json?
  providerConfig    Json?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("social_marketing_report_settings")
}

// ============================================================

// LEAD CENTER MODULE
// ============================================================

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  icon           String?
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("lead_sources")
}

model Lead {
  id                     String     @id @default(cuid())
  organizationId         String
  leadCode               String?
  fullName               String
  companyName            String?
  email                  String?
  phone                  String?
  jobTitle               String?
  website                String?
  sourceId               String?
  formId                 String?
  webhookId              String?
  campaign               String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  city                   String?
  province               String?
  address                String?    @db.Text
  note                   String?    @db.Text
  status                 LeadStatus @default(NEW)
  score                  Int        @default(0)
  assignedTo             String?
  convertedCustomerId    String?
  convertedOpportunityId String?
  convertedAt            DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         LeadSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  form           LeadForm?          @relation(fields: [formId], references: [id], onDelete: SetNull)
  webhook        LeadWebhook?       @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  assignee       User?              @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tagItems       LeadTagItem[]
  activities     LeadActivity[]
  duplicateLogs1 LeadDuplicateLog[] @relation("LeadDuplicateLogLead1")
  duplicateLogs2 LeadDuplicateLog[] @relation("LeadDuplicateLogLead2")

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([sourceId])
  @@index([formId])
  @@index([webhookId])
  @@map("leads")
}

model LeadTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tagItems     LeadTagItem[]

  @@index([organizationId])
  @@map("lead_tags")
}

model LeadTagItem {
  id        String   @id @default(cuid())
  leadId    String
  tagId     String
  createdAt DateTime @default(now())

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([leadId])
  @@index([tagId])
  @@map("lead_tag_items")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  title     String?
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}

model LeadDuplicateLog {
  id            String   @id @default(cuid())
  leadId        String
  matchedLeadId String
  matchPercent  Int      @default(100)
  matchReason   String?  @db.Text
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  lead        Lead  @relation("LeadDuplicateLogLead1", fields: [leadId], references: [id], onDelete: Cascade)
  matchedLead Lead  @relation("LeadDuplicateLogLead2", fields: [matchedLeadId], references: [id], onDelete: Cascade)
  resolver    User? @relation("LeadDuplicateResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([matchedLeadId])
  @@map("lead_duplicate_logs")
}

model LeadForm {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  title            String?
  description      String?  @db.Text
  submitButtonText String   @default("Gửi")
