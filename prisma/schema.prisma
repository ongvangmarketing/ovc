  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
  ASSIGNMENT
  LIVE
}

enum LessonScheduleMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
