}

enum SocialConnectionStatus {
  PENDING
  ACTIVE
  ATTENTION_REQUIRED
  EXPIRED
  DISCONNECTED
}

enum SocialAssetType {
  BUSINESS
  PAGE
  AD_ACCOUNT
}

enum SocialEntityStatus {
