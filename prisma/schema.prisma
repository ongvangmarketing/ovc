  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  mobile         String?
  jobTitle       String?
  department     String?
  type           ContactType   @default(LEAD)
  status         ContactStatus @default(ACTIVE)
  priority       Priority      @default(MEDIUM)
  source         String?
  tags           String[]      @default([])
  notes          String?
