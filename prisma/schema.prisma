// Ong Vàng Workspace — Full Prisma Schema
// Enterprise SaaS Platform 2026
// Covers: Auth, CRM, Finance, Projects, Courses, Marketing, CMS, Notifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
  INSTRUCTOR
  STUDENT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ContactType {
  LEAD
  PROSPECT
  CUSTOMER
  PARTNER
  VENDOR
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DealStatus {
  OPEN
  WON
  LOST
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  MEMBER_ADDED
  MEMBER_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  COMMENT_ADDED
  FILE_UPLOADED
  DATABASE_CREATED
  DATABASE_UPDATED
  DATABASE_RECORD_CREATED
  DATABASE_RECORD_UPDATED
  SHARE_LINK_CREATED
  PUBLIC_RECORD_EDITED
}

enum ProjectFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  SELECT
  MULTI_SELECT
  STATUS
  DATE
  DATE_RANGE
  PERSON
  CUSTOMER
  FILE
  URL
  EMAIL
  PHONE
  CHECKBOX
  PROGRESS
  RATING
  FORMULA
