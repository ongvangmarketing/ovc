  sortOrder      Int      @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("service_categories")
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  createdBy      String?
  name           String
  slug           String
  description    String?  @db.Text
  status         String   @default("ACTIVE")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options      ServiceOption[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoryId])
  @@map("services")
}

model ServiceOption {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String
  name           String
  description    String?  @db.Text
  price          Decimal  @default(0) @db.Decimal(18, 2)
  currency       String   @default("VND")
  unit           String?
  durationText   String?
  featuresJson   Json?
  status         String   @default("ACTIVE")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dealOptions  DealServiceOption[]

  @@index([organizationId])
  @@index([serviceId])
  @@map("service_options")
}

model DealServiceOption {
  id              String   @id @default(cuid())
  organizationId  String
  dealId          String
  serviceOptionId String
  quantity        Int      @default(1)
  unitPrice       Decimal  @default(0) @db.Decimal(18, 2)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  taxRate         Decimal  @default(0) @db.Decimal(8, 2)
  note            String?  @db.Text
  status          String   @default("PROPOSED")
  selectedAt      DateTime?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal          Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  serviceOption ServiceOption @relation(fields: [serviceOptionId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([dealId])
  @@index([serviceOptionId])
  @@map("deal_service_options")
}

model ContactActivity {
  id          String    @id @default(cuid())
  contactId   String
  type        String // call, email, meeting, note
  subject     String?
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_activities")
}

// ============================================================
// PROJECTS MODULE
// ============================================================

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  priority       Priority      @default(MEDIUM)
  ownerId        String
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  budget         Decimal?
  currency       String        @default("VND")
  color          String        @default("#F59E0B")
  icon           String?
  isArchived     Boolean       @default(false)
  customFields   Json?
  contactId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members      ProjectMember[]
  tasks        Task[]
  taskLists    TaskList[]
  quotations   Quotation[]
  invoices     Invoice[]       @relation("ProjectInvoices")
  files        File[]          @relation("ProjectFiles")
  activities   ProjectActivity[]
  databases    ProjectDatabase[]

  @@index([organizationId])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

model TaskList {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String?
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("task_lists")
}

model Task {
  id             String     @id @default(cuid())
  projectId      String
  taskListId     String?
  parentId       String?
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?
  creatorId      String
  dueDate        DateTime?
  startDate      DateTime?
  completedAt    DateTime?
  estimatedHours Decimal?
  actualHours    Decimal?
  order          Float      @default(0)
  tags           String[]   @default([])
  customFields   Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskList    TaskList?     @relation(fields: [taskListId], references: [id])
  parent      Task?         @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks    Task[]        @relation("TaskSubtasks")
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User          @relation("TaskCreator", fields: [creatorId], references: [id])
  comments    TaskComment[]
  labels      TaskLabel[]
  attachments File[]        @relation("TaskFiles")
  activities  ProjectActivity[]

  @@index([projectId])
  @@index([taskListId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskLabel {
  id        String   @id @default(cuid())
  taskId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_labels")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

model ProjectActivity {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String?
  taskId         String?
  type           ProjectActivityType
  title          String
  description    String?
  metadata       Json?
  actorId        String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@map("project_activities")
}

model ProjectDatabase {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  icon           String?
  color          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?                      @relation(fields: [createdById], references: [id])
  fields       ProjectDatabaseField[]
  views        ProjectDatabaseView[]
  records      ProjectDatabaseRecord[]
  shareLinks   ProjectDatabaseShareLink[]
  changeLogs   ProjectDatabaseChangeLog[]

  @@index([organizationId])
  @@index([projectId])
  @@map("project_databases")
}

model ProjectDatabaseField {
  id               String           @id @default(cuid())
  organizationId   String
  databaseId       String
  name             String
  key              String
  type             ProjectFieldType
  order            Int              @default(0)
  required         Boolean          @default(false)
  hidden           Boolean          @default(false)
  internal         Boolean          @default(false)
  options          Json?
  config           Json?
  automationKey    String?
  isAutomationDate Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  database ProjectDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([databaseId])
  @@unique([databaseId, key])
  @@map("project_database_fields")
}

model ProjectDatabaseView {
  id             String          @id @default(cuid())
  organizationId String
  databaseId     String
  name           String
  type           ProjectViewType
  order          Int             @default(0)
  filters        Json?
  sorts          Json?
  groups         Json?
  visibleFields  Json?
  settings       Json?
  isDefault      Boolean         @default(false)
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  database   ProjectDatabase             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  shareLinks ProjectDatabaseShareLink[]

  @@index([organizationId])
  @@index([databaseId])
  @@map("project_database_views")
}

model ProjectDatabaseRecord {
  id             String    @id @default(cuid())
  organizationId String
  databaseId     String
  values         Json
  order          Int       @default(0)
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  database  ProjectDatabase             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdBy User?                       @relation("ProjectDatabaseRecordCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                       @relation("ProjectDatabaseRecordUpdatedBy", fields: [updatedById], references: [id])
  changes   ProjectDatabaseChangeLog[]

  @@index([organizationId])
  @@index([databaseId])
  @@map("project_database_records")
}

model ProjectDatabaseShareLink {
  id               String                 @id @default(cuid())
  organizationId   String
  databaseId       String
  viewId           String?
  token            String                 @unique
  name             String
  permission       ProjectSharePermission @default(VIEW)
  passwordHash     String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  allowEdit        Boolean                @default(false)
  allowComment     Boolean                @default(false)
  allowUpload      Boolean                @default(false)
  requireGuestInfo Boolean                @default(false)
  hiddenFields     Json?
  filters          Json?
  settings         Json?
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  database  ProjectDatabase      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  view      ProjectDatabaseView? @relation(fields: [viewId], references: [id])
  createdBy User?                @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([databaseId])
  @@index([token])
  @@map("project_database_share_links")
}

model ProjectDatabaseChangeLog {
  id             String                      @id @default(cuid())
  organizationId String
  databaseId     String
  recordId       String?
  actorType      ProjectDatabaseActorType
  actorUserId    String?
  guestName      String?
  guestEmail     String?
  shareToken     String?
  action         ProjectDatabaseChangeAction
  fieldKey       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime                    @default(now())

  database  ProjectDatabase        @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  record    ProjectDatabaseRecord? @relation(fields: [recordId], references: [id])
  actorUser User?                  @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([databaseId])
  @@index([recordId])
  @@map("project_database_change_logs")
}

// ============================================================
// FINANCE MODULE
// ============================================================

model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  number         String
  title          String
  status         QuotationStatus @default(DRAFT)
  contactId      String?
  companyId      String?
  projectId      String?
  dealId         String?
  assigneeId     String?
  creatorId      String
  currency       String          @default("VND")
  subtotal       Decimal         @default(0)
  discount       Decimal         @default(0)
  discountType   String          @default("fixed") // fixed | percent
  tax            Decimal         @default(0)
  taxRate        Decimal         @default(0)
  total          Decimal         @default(0)
  notes          String?
  terms          String?
  validUntil     DateTime?
  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  convertedAt    DateTime?
  invoiceId      String?
  contractId     String?
  token          String?         @unique
  adminSignedAt  DateTime?
  signedAt       DateTime?
  customerSignatureRequired Boolean @default(true)
  signatureId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?           @relation(fields: [contactId], references: [id])
  company      Company?           @relation(fields: [companyId], references: [id])
  project      Project?           @relation(fields: [projectId], references: [id])
  deal         Deal?              @relation(fields: [dealId], references: [id])
  assignee     User?              @relation("QuotationAssignee", fields: [assigneeId], references: [id])
  creator      User               @relation("QuotationCreator", fields: [creatorId], references: [id])
  items        QuotationItem[]
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id])
  contract     Contract?          @relation(fields: [contractId], references: [id])
  signature    DocumentSignature? @relation("QuotationSignature", fields: [signatureId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([companyId])
  @@index([dealId])
  @@index([assigneeId])
  @@index([projectId])
  @@index([token])
  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  name        String
  description String?
  unit        String?
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  discount    Decimal  @default(0)
  tax         Decimal  @default(0)
  total       Decimal  @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  number          String
  title           String?
  status          InvoiceStatus @default(DRAFT)
  contactId       String?
  companyId       String?
  projectId       String?
  dealId          String?
  assigneeId      String?
  creatorId       String
  currency        String        @default("VND")
  paymentChannels Json?
  subtotal        Decimal       @default(0)
  discount        Decimal       @default(0)
  discountType    String        @default("fixed")
  tax             Decimal       @default(0)
  taxRate         Decimal       @default(0)
  total           Decimal       @default(0)
  amountPaid      Decimal       @default(0)
  amountDue       Decimal       @default(0)
  notes           String?
  terms           String?
  dueDate         DateTime?
  issuedAt        DateTime?
  sentAt          DateTime?
  paidAt          DateTime?
  token           String?       @unique
  adminSignedAt   DateTime?
  signedAt        DateTime?
  customerSignatureRequired Boolean @default(true)
  signatureId     String?
  contractId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             Contact?             @relation(fields: [contactId], references: [id])
  company             Company?             @relation(fields: [companyId], references: [id])
  project             Project?             @relation("ProjectInvoices", fields: [projectId], references: [id])
  deal                Deal?                @relation(fields: [dealId], references: [id])
  assignee            User?                @relation("InvoiceAssignee", fields: [assigneeId], references: [id])
  creator             User                 @relation("InvoiceCreator", fields: [creatorId], references: [id])
  items               InvoiceItem[]
  paymentInstallments PaymentInstallment[]
  payments            Payment[]
  quotations          Quotation[]
  contract            Contract?            @relation(fields: [contractId], references: [id])
  signature           DocumentSignature?   @relation("InvoiceSignature", fields: [signatureId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([companyId])
  @@index([dealId])
  @@index([assigneeId])
  @@index([token])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  name        String
  description String?
  unit        String?
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  discount    Decimal  @default(0)
  tax         Decimal  @default(0)
  total       Decimal  @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String?
  number         String?
  amount         Decimal
  currency       String        @default("VND")
  method         PaymentMethod @default(BANK_TRANSFER)
  status         PaymentStatus @default(PENDING)
  reference      String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@unique([organizationId, number])
  @@map("payments")
}

model Contract {
  id              String         @id @default(cuid())
  organizationId  String
  number          String
  title           String
  status          ContractStatus @default(DRAFT)
  contactId       String?
  companyId       String?
  dealId          String?
  assigneeId      String?
  creatorId       String
  currency        String         @default("VND")
  paymentChannels Json?
  subtotal        Decimal        @default(0)
  discount        Decimal        @default(0)
  discountType    String         @default("fixed")
  tax             Decimal        @default(0)
  total           Decimal        @default(0)
  notes           String?
  terms           String?
  validFrom       DateTime?
  validUntil      DateTime?
  sentAt          DateTime?
  adminSignedAt   DateTime?
  signedAt        DateTime?
  customerSignatureRequired Boolean @default(true)
  token           String?        @unique
  signatureId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             Contact?             @relation(fields: [contactId], references: [id])
  company             Company?             @relation(fields: [companyId], references: [id])
  deal                Deal?                @relation(fields: [dealId], references: [id])
  assignee            User?                @relation("ContractAssignee", fields: [assigneeId], references: [id])
  creator             User                 @relation("ContractCreator", fields: [creatorId], references: [id])
  items               ContractItem[]
  paymentInstallments PaymentInstallment[]
  invoices            Invoice[]
  quotations          Quotation[]
  signature           DocumentSignature?   @relation("ContractSignature", fields: [signatureId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([companyId])
  @@index([dealId])
  @@index([assigneeId])
  @@index([token])
  @@map("contracts")
}

model ContractItem {
  id          String   @id @default(cuid())
  contractId  String
  name        String
  description String?
  unit        String?
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  total       Decimal  @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_items")
}

model DocumentSignature {
  id             String   @id @default(cuid())
  organizationId String
  signerName     String
  signerEmail    String?
  signatureData  String   @db.Text // Base64 image or text
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]  @relation("QuotationSignature")
  contracts    Contract[]   @relation("ContractSignature")
  invoices     Invoice[]    @relation("InvoiceSignature")

  @@index([organizationId])
  @@map("document_signatures")
}

// ============================================================
// COURSES / LMS MODULE
// ============================================================

model PotentialStudent {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  source         String?
  interestedIn   String?
  status         String    @default("new")
  note           String?   @db.Text
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("potential_students")
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  instructorId   String
  title          String
  slug           String
  description    String?
  thumbnail      String?
  status         CourseStatus @default(DRAFT)
  price          Decimal      @default(0)
  currency       String       @default("VND")
  level          String       @default("beginner") // beginner | intermediate | advanced
  language       String       @default("vi")
  duration       Int? // total minutes
  tags           String[]     @default([])
  requirements   String[]     @default([])
  outcomes       String[]     @default([])
  categoryId     String?
  isPublic       Boolean      @default(false)
  isFeatured     Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor   User            @relation("CourseInstructor", fields: [instructorId], references: [id])
  sections     CourseSection[]
  enrollments  Enrollment[]
  classes      Class[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("courses")
}

model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  description String?
  type        LessonType @default(VIDEO)
  content     String? // rich text content
  videoUrl    String?
  duration    Int? // minutes
  order       Int        @default(0)
  isFree      Boolean    @default(false)
  isPublished Boolean    @default(false)
  resources   String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  section     CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  schedules   LessonSchedule[]

  @@index([sectionId])
  @@map("lessons")
}

model LessonSchedule {
  id            String             @id @default(cuid())
  lessonId      String
  classId       String?
  title         String?
  mode          LessonScheduleMode @default(OFFLINE)
  startsAt      DateTime?
  endsAt        DateTime?
  location      String?
  onlineUrl     String?
  fieldAddress  String?
  instructorId  String?
  capacity      Int?
  note          String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  class      Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  instructor User?  @relation("LessonScheduleInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([classId])
  @@index([instructorId])
  @@map("lesson_schedules")
}

model Class {
  id          String    @id @default(cuid())
  courseId    String
  name        String
  code        String?
  startDate   DateTime?
  endDate     DateTime?
  schedule    Json? // recurring schedule config
  location    String?
  maxStudents Int       @default(30)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendances Attendance[]
  lessonSchedules LessonSchedule[]

  @@index([courseId])
  @@map("classes")
}

model Enrollment {
  id            String           @id @default(cuid())
  courseId      String
  classId       String?
  studentId     String
  status        EnrollmentStatus @default(PENDING)
  progress      Int              @default(0) // percentage
  tuitionFee    Decimal          @default(0)
  paidAmount    Decimal          @default(0)
  paymentStatus String           @default("unpaid")
  paymentNote   String?          @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  certificateAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class       Class?             @relation(fields: [classId], references: [id])
  student     User               @relation(fields: [studentId], references: [id])
  completions LessonCompletion[]

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@map("enrollments")
}

model LessonCompletion {
  id           String   @id @default(cuid())
  lessonId     String
  enrollmentId String
  completedAt  DateTime @default(now())

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, enrollmentId])
  @@map("lesson_completions")
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  date      DateTime
  present   Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, date])
  @@index([classId])
  @@map("attendances")
}

model Assignment {
  id          String    @id @default(cuid())
  lessonId    String?
  title       String
  description String?
  dueDate     DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  graderId     String?
  content      String?
  fileUrl      String?
  score        Int?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentStudent", fields: [studentId], references: [id])
  grader     User?      @relation("AssignmentGrader", fields: [graderId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@map("assignment_submissions")
}

// ============================================================
// MARKETING MODULE
// ============================================================

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  type           CampaignType   @default(EMAIL)
  status         CampaignStatus @default(DRAFT)
  description    String?
  subject        String?
  content        String?
  templateId     String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  targetCount    Int            @default(0)
  sentCount      Int            @default(0)
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  tags           String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("campaigns")
}

// ============================================================
// CMS MODULE
// ============================================================

model Site {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  domain         String?    @unique
  subdomain      String?    @unique
  status         SiteStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        Page[]

  @@index([organizationId])
  @@map("sites")
}

model Page {
  id             String     @id @default(cuid())
  organizationId String
  siteId         String?
  title          String
  slug           String
  content        Json? // rich text / blocks JSON
  status         PostStatus @default(DRAFT)
  template       String?
  metaTitle      String?
  metaDesc       String?
  thumbnail      String?
  order          Int        @default(0)
  parentId       String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent       Page?        @relation("PageChildren", fields: [parentId], references: [id])
  children     Page[]       @relation("PageChildren")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([siteId])
  @@map("pages")
}

model Post {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  slug           String
  excerpt        String?
  content        String?
  status         PostStatus @default(DRAFT)
  thumbnail      String?
  metaTitle      String?
  metaDesc       String?
  featured       Boolean    @default(false)
  viewCount      Int        @default(0)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   Category[]   @relation("PostCategories")
  tags         Tag[]        @relation("PostTags")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("posts")
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryChildren")
  posts        Post[]       @relation("PostCategories")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        Post[]       @relation("PostTags")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tags")
}

model Media {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  filename       String
  url            String
  type           String // image, video, document, audio
  mimeType       String
  size           Int // bytes
  width          Int?
  height         Int?
  alt            String?
  caption        String?
  folderId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       Folder?      @relation(fields: [folderId], references: [id])

  @@index([organizationId])
  @@map("media")
}

// ============================================================
// FILE MANAGEMENT
// ============================================================

model Folder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Folder?      @relation("FolderChildren", fields: [parentId], references: [id])
  children     Folder[]     @relation("FolderChildren")
  files        File[]
  media        Media[]

  @@index([organizationId])
  @@map("folders")
}

model File {
  id             String   @id @default(cuid())
  organizationId String
  uploaderId     String
  name           String
  filename       String
  url            String
  type           String
  mimeType       String
  size           Int
  folderId       String?
  projectId      String?
  taskId         String?
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id])
  folder       Folder?      @relation(fields: [folderId], references: [id])
  project      Project?     @relation("ProjectFiles", fields: [projectId], references: [id])
  task         Task?        @relation("TaskFiles", fields: [taskId], references: [id])

  @@index([organizationId])
  @@map("files")
}

// ============================================================
// NOTIFICATIONS & ACTIVITY
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // created, updated, deleted, login, etc.
  entity         String // Contact, Task, Invoice, etc.
  entityId       String?
  description    String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_logs")
}

model PaymentInstallment {
  id         String   @id @default(cuid())
  contractId String?
  invoiceId  String?
  name       String
  amount     Decimal  @default(0)
  dueDate    DateTime
  status     String   @default("PENDING") // PENDING, PAID, OVERDUE

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

// ============================================================
// SETTINGS MODULE
// ============================================================

model Setting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String?  @db.Text
  type           String   @default("string") // string, json, boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("settings")
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  code           String // e.g. SEND_QUOTATION, SEND_CONTRACT
  name           String
  subject        String
  body           String   @db.Text
  variables      String[] @default([]) // e.g. ["customer_name", "document_link"]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("email_templates")
}

model EmailLog {
  id               String    @id @default(cuid())
  organizationId   String
  status           String    @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  provider         String?
  templateCode     String?
  subject          String?
  to               Json?
  cc               Json?
  bcc              Json?
  fromEmail        String?
  fromName         String?
  messageId        String?
  attachmentsCount Int       @default(0)
  relatedType      String?
  relatedId        String?
  errorMessage     String?   @db.Text
  metadata         Json?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([relatedType, relatedId])
  @@map("email_logs")
}

model LegacyImportRun {
  id             String    @id @default(cuid())
  organizationId String
  source         String    @default("ongvang.com.vn")
  mode           String    @default("DRY_RUN") // DRY_RUN, IMPORT
  status         String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  summary        Json?
  errorMessage   String?   @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([source])
  @@index([status])
  @@map("legacy_import_runs")
}
